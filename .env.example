# ==========================================================================
# Portal Família Àṣẹ Omos Odé — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou .env (Docker). NUNCA versione o arquivo real.
# O script scripts/configurar-ambiente.ps1 gera o .env.local e o .env automaticamente.
# ==========================================================================

# --- Supabase (públicas: vão para o navegador) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=__PREENCHER__
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_ORG_SLUG=omos-ode

# --- Somente servidor (segredos) ---
# Chave de serviço do Supabase: usada só pelas rotinas automáticas. Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=__PREENCHER__
# URL que o servidor usa para falar com o Supabase (no Docker: http://host.docker.internal:55421)
SUPABASE_INTERNAL_URL=
# Token das rotinas automáticas (/api/cron/*) — mínimo 16 caracteres aleatórios
CRON_SECRET=__GERAR__
# Token para o Prometheus ler /api/metrics
METRICS_TOKEN=__GERAR__

# --- Login com Google (opcional; ver docs/GUIA-LOGIN-GOOGLE.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- reCAPTCHA v2 "Não sou um robô" no login (opcional; liga com as duas preenchidas) ---
# Criar em https://www.google.com/recaptcha/admin → tipo "Desafio (v2)" → "Caixa de seleção"
# Chave do site (pública)
RECAPTCHA_SITE_KEY=
# Chave secreta (segredo — só servidor)
RECAPTCHA_SECRET_KEY=

# --- Docker / monitoramento ---
WEB_HOST_PORT=3020
PROMETHEUS_HOST_PORT=9096
GRAFANA_HOST_PORT=3006
GRAFANA_ADMIN_PASSWORD=__GERAR__
